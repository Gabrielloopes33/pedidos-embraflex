# Frontend Environment Variables - Development
# Copie para .env.local para desenvolvimento
# Copie para .env.production para produção no Netlify

# Backend API Configuration
VITE_API_BASE_URL=http://localhost:3000/api

# Produção (descomentar e ajustar):
# VITE_API_BASE_URL=https://seu-backend.onrender.com/api

# WooCommerce API Configuration
VITE_WOOCOMMERCE_URL=https://embraflexbr.com.br
VITE_WOOCOMMERCE_CONSUMER_KEY=ck_sua_consumer_key
VITE_WOOCOMMERCE_CONSUMER_SECRET=cs_seu_consumer_secret

# ==================== BACKEND ENVIRONMENT VARIABLES ====================
# Estas variáveis devem ser configuradas no backend (.env)

# Supabase Configuration
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua_chave_anon
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role

# JWT Configuration
JWT_SECRET=seu_segredo_super_secreto_para_jwt

# App Configuration
APP_URL=http://localhost:5173
# Produção: APP_URL=https://seu-frontend.netlify.app

# Webhook Configuration
WEBHOOK_QUOTE_SIGNED=https://flow.agenciatouch.com.br/webhook/seu-webhook-id
WEBHOOK_QUOTE_REJECTED=https://flow.agenciatouch.com.br/webhook/seu-webhook-id

# Email Configuration (opcional)
EMAIL_FROM=noreply@embraflex.com
EMAIL_TO=producao@embraflex.com

# ==================== SYNC & CACHE CONFIGURATION ====================
# Configurações de sincronização do WooCommerce com Supabase

# Cache TTL (em minutos) - Tempo que o cache é considerado válido
CACHE_TTL_MINUTES=60

# Sync Interval (em minutos) - Intervalo entre syncs automáticos
SYNC_INTERVAL_MINUTES=30

# Batch Size - Número de itens por página ao buscar do WooCommerce
SYNC_BATCH_SIZE=100

# Cache Cleanup - Dias para manter produtos inativos no cache
CACHE_CLEANUP_DAYS=30

# Enable Auto Sync - Habilita sync automático em background
ENABLE_AUTO_SYNC=true
