    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT l.*, c.assunto, c.corpo_html\nFROM leads_nutricao l\nLEFT JOIN nutricao_campanhas_email c ON c.segmento = l.nicho || '_' || l.faturamento\nWHERE l.status = 'ativo'\n  AND l.fase_atual IN ('reativacao', 'lembretes')\n  AND (\n    l.data_ultimo_email IS NULL \n    OR l.data_ultimo_email < NOW() - INTERVAL '2 days'\n  )\n  AND l.total_emails_enviados < 5\n  AND c.ativa = true\nORDER BY l.data_conversao DESC\nLIMIT 50;",
        "options": {}
      },
      "name": "Buscar Leads para Email",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [450, 600],
      "id": "postgres-select-email-1",
      "credentials": {
        "postgres": {
          "id": "2",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Personalizar email com variáveis do lead\nconst emails = [];\n\nfor (const item of $input.all()) {\n  const lead = item.json;\n  \n  let corpo = lead.corpo_html || '';\n  let assunto = lead.assunto || 'Olá {{nome}}';\n  \n  // Substituir variáveis\n  corpo = corpo.replace(/{{nome}}/g, lead.nome);\n  corpo = corpo.replace(/{{nicho}}/g, lead.nicho);\n  \n  assunto = assunto.replace(/{{nome}}/g, lead.nome);\n  \n  // Adicionar link de rastreamento\n  const trackingUrl = `https://seu-dominio.com/track?lead_id=${lead.id}&action=click`;\n  corpo = corpo.replace('{{link_cta}}', trackingUrl);\n  \n  emails.push({\n    ...lead,\n    corpo_personalizado: corpo,\n    assunto_personalizado: assunto,\n    tracking_url: trackingUrl\n  });\n}\n\nreturn emails;"
      },
