    {
      "parameters": {
        "jsCode": "// Personalizar WhatsApp\nconst mensagens = [];\n\nfor (const item of $input.all()) {\n  const lead = item.json;\n  \n  let mensagem = lead.mensagem || 'Olá {{nome}}!';\n  \n  // Substituir variáveis\n  mensagem = mensagem.replace(/{{nome}}/g, lead.nome);\n  mensagem = mensagem.replace(/{{nicho}}/g, lead.nicho);\n  \n  // Adicionar link rastreável\n  const trackingUrl = `https://seu-dominio.com/track?lead_id=${lead.id}&action=whatsapp_click`;\n  mensagem = mensagem.replace('{{link}}', trackingUrl);\n  \n  // Formatar telefone para Evolution API (55DDNÚMERO)\n  let telefone = lead.telefone.replace(/\\D/g, '');\n  if (!telefone.startsWith('55')) telefone = '55' + telefone;\n  \n  mensagens.push({\n    ...lead,\n    mensagem_personalizada: mensagem,\n    telefone_formatado: telefone + '@s.whatsapp.net',\n    tracking_url: trackingUrl\n  });\n}\n\nreturn mensagens;"
      },
