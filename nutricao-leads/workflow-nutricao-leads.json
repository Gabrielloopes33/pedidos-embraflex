    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT l.*, t.mensagem\nFROM leads_nutricao l\nLEFT JOIN nutricao_templates_whatsapp t ON t.segmento = l.nicho || '_' || l.faturamento\nWHERE l.status = 'ativo'\n  AND l.nivel_engajamento IN ('morno', 'quente')\n  AND l.telefone IS NOT NULL\n  AND l.telefone != ''\n  AND (\n    l.data_ultimo_whatsapp IS NULL \n    OR l.data_ultimo_whatsapp < NOW() - INTERVAL '3 days'\n  )\n  AND l.total_whatsapp_enviados < 3\n  AND t.ativo = true\nORDER BY l.nivel_engajamento DESC, l.total_cliques_link DESC\nLIMIT 20;",
        "options": {}
      },
      "name": "Buscar Leads para WhatsApp",
      "type": "n8n-nodes-base.postgres",
